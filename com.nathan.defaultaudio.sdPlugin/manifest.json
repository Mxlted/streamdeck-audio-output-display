{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "Default Audio Device",
    "Description": "Displays and sets default Windows audio devices from Stream Deck keys.",
    "Author": "Nathan",
    "Version": "1.3.1.0",
    "Icon": "imgs/plugin/marketplace",
    "URL": "https://github.com/Mxlted/streamdeck-audio-output-display",
    "SupportURL": "https://github.com/Mxlted/streamdeck-audio-output-display/issues",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "CodePath": "bin/plugin.js",
    "UUID": "com.nathan.defaultaudio",
    "Category": "Default Audio Device",
    "CategoryIcon": "imgs/plugin/category-icon",
    "Actions": [
        {
            "Name": "Default Audio",
            "UUID": "com.nathan.defaultaudio.show",
            "Icon": "imgs/actions/audio-device/display-icon",
            "Tooltip": "Shows the current default audio output device. Press to refresh.",
            "PropertyInspectorPath": "ui/audio-device.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/audio-device/display-key",
                    "TitleAlignment": "middle",
                    "FontSize": 9,
                    "FontStyle": "Bold",
                    "FontFamily": "Arial",
                    "TitleColor": "#FFFFFF",
                    "ShowTitle": true
                }
            ],
            "DisableAutomaticStates": true,
            "SupportedInKeyLogicActions": false,
            "SupportedInMultiActions": false
        },
        {
            "Name": "Set Default Output",
            "UUID": "com.nathan.defaultaudio.set-output",
            "Icon": "imgs/actions/audio-device/output-icon",
            "Tooltip": "Sets the default Windows audio output device by name, including communications default.",
            "PropertyInspectorPath": "ui/set-default-device.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/audio-device/output-key",
                    "TitleAlignment": "middle",
                    "FontSize": 9,
                    "FontStyle": "Bold",
                    "FontFamily": "Arial",
                    "TitleColor": "#FFFFFF",
                    "ShowTitle": true
                }
            ],
            "DisableAutomaticStates": true,
            "SupportedInKeyLogicActions": true,
            "SupportedInMultiActions": true
        },
        {
            "Name": "Set Default Input",
            "UUID": "com.nathan.defaultaudio.set-input",
            "Icon": "imgs/actions/audio-device/input-icon",
            "Tooltip": "Sets the default Windows audio input device by name, including communications default.",
            "PropertyInspectorPath": "ui/set-default-device.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/audio-device/input-key",
                    "TitleAlignment": "middle",
                    "FontSize": 9,
                    "FontStyle": "Bold",
                    "FontFamily": "Arial",
                    "TitleColor": "#FFFFFF",
                    "ShowTitle": true
                }
            ],
            "DisableAutomaticStates": true,
            "SupportedInKeyLogicActions": true,
            "SupportedInMultiActions": true
        }
    ]
}