{
    "name": "com.nathan.defaultaudio",
    "version": "1.3.1",
    "description": "Stream Deck plugin that displays and sets default Windows audio devices.",
    "main": "com.nathan.defaultaudio.sdPlugin/bin/plugin.js",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test:compile": "tsc -p tsconfig.test.json",
        "test": "npm run test:compile && node --test .test-dist/tests/name-shortener.test.js .test-dist/tests/process-runner.test.js .test-dist/tests/property-inspector.test.js .test-dist/tests/watcher-script.test.js",
        "check": "npm run typecheck && npm test && npm run build && npm run validate",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.nathan.defaultaudio\"",
        "prepackage": "npm run build && npm run validate",
        "package": "streamdeck pack com.nathan.defaultaudio.sdPlugin",
        "validate": "streamdeck validate com.nathan.defaultaudio.sdPlugin",
        "link": "streamdeck link com.nathan.defaultaudio.sdPlugin",
        "restart": "streamdeck restart com.nathan.defaultaudio"
    },
    "author": "Nathan",
    "license": "MIT",
    "dependencies": {
        "@elgato/streamdeck": "^2.1.0",
        "@elgato/utils": "^0.4.5"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.3.0",
        "@rollup/plugin-typescript": "^12.1.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.13.3",
        "rollup": "^4.24.0",
        "tslib": "^2.7.0",
        "typescript": "^5.6.3"
    },
    "overrides": {
        "ws": "^8.21.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mxlted/streamdeck-audio-output-display.git"
    },
    "bugs": {
        "url": "https://github.com/Mxlted/streamdeck-audio-output-display/issues"
    },
    "homepage": "https://github.com/Mxlted/streamdeck-audio-output-display#readme",
    "engines": {
        "node": ">=24"
    }
}
