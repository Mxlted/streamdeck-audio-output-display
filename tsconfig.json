{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "lib": ["ES2024"],
        "target": "ES2024",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "com.nathan.defaultaudio.sdPlugin/bin",
        "rootDir": "src",
        "sourceMap": true,
        "useDefineForClassFields": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "com.nathan.defaultaudio.sdPlugin/bin"]
}
